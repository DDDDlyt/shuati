[{"t":"term","c":"名词","q":"什么是基因互作？","a":"<b>两对或以上非等位基因</b>相互作用共同影响同一性状","n":"关键词：非等位 + 一起干活","deck":"genetics-flash","id":"genetics-flash_0","k":["mendel"]},{"t":"term","c":"名词","q":"互补作用的比例与含义？","a":"比例 <b>9:7</b>；两显性基因<b>都需存在</b>才表现某性状","n":"互补=俩都要","deck":"genetics-flash","id":"genetics-flash_1","k":["interact"],"h":"9:7 = 两把钥匙开一把锁，缺一不可","hk":"interact"},{"t":"term","c":"名词","q":"积加作用的比例？","a":"<b>9:6:1</b>：双显大效、单显中效、双隐低效","n":"积加=加起来","deck":"genetics-flash","id":"genetics-flash_2","k":["interact"],"h":"积加 9:6:1：两个显性各给一种表型，凑一起又是第三种","hk":"interact"},{"t":"term","c":"名词","q":"重叠作用的比例？","a":"<b>15:1</b>：任一显性基因即表现","n":"重叠=有一个就行","deck":"genetics-flash","id":"genetics-flash_3","k":["interact"],"h":"15:1：只要有一个显性就够，全隐才变","hk":"interact"},{"t":"term","c":"名词","q":"隐性上位的比例？","a":"<b>9:3:4</b>：隐性基因掩盖另一基因","n":"隐性上位=隐性的压住显性","deck":"genetics-flash","id":"genetics-flash_4","k":["interact","mendel"],"h":"9:3:4：bb 一票否决，把 B 的表现整个吞掉","hk":"interact"},{"t":"term","c":"名词","q":"显性上位的比例？","a":"<b>12:3:1</b>：显性基因掩盖其他","n":"显性上位=显性的压住一切","deck":"genetics-flash","id":"genetics-flash_5","k":["interact"],"h":"12:3:1：A 一在场，B 说什么都没用","hk":"interact"},{"t":"term","c":"名词","q":"抑制作用的比例？","a":"<b>13:3</b>：抑制基因压制另一基因","n":"抑制=专门按住你","deck":"genetics-flash","id":"genetics-flash_6","k":["interact"],"h":"抑制 13:3：I 在场就压住 C，只有 iiC_ 才显色","hk":"interact"},{"t":"term","c":"名词","q":"操纵子是什么？","a":"原核功能单位 = <b>启动子P + 操纵基因O + 结构基因 + 调节基因I</b>","n":"一套班子管一串基因","deck":"genetics-flash","id":"genetics-flash_7","k":["geneexp"],"h":"操纵子 = 启动子 + 操纵基因 + 结构基因，一套开关管一串基因","hk":"geneexp"},{"t":"term","c":"名词","q":"启动子(P)是啥？","a":"<b>RNA聚合酶结合位点</b>，不编码蛋白","n":"P=聚酶停车位","deck":"genetics-flash","id":"genetics-flash_8","k":["trans","geneexp"],"h":"原核 -10 TATAAT、-35 TTGACA；真核是 TATA 盒","hk":"trans"},{"t":"term","c":"名词","q":"操纵基因(O)是啥？","a":"<b>阻遏蛋白结合位点</b>，负调控元件，不编码蛋白","n":"O=阻遏锁孔","deck":"genetics-flash","id":"genetics-flash_9","k":["geneexp"]},{"t":"term","c":"名词","q":"测交是什么？","a":"与<b>隐性纯合</b>杂交测基因型，比例 1:1","n":"测交=拿白花试你","deck":"genetics-flash","id":"genetics-flash_10","k":["mendel"],"h":"测交配隐性纯合，后代比例 = 配子比例（这是万能钥匙）","hk":"mendel"},{"t":"term","c":"名词","q":"连锁群数目 = ?","a":"= <b>单倍体染色体数 n</b>","n":"几条单倍染色体就几个群","deck":"genetics-flash","id":"genetics-flash_11","k":["num","linkage"]},{"t":"term","c":"名词","q":"交换值 / 图距的关系？","a":"交换值 = 重组率 = 图距(cM)；<b>1 cM = 1% 重组率</b>","n":"1cM=1%","deck":"genetics-flash","id":"genetics-flash_12","k":["linkage"],"h":"交换值超 50% 就按 50% 算，重组率封顶","hk":"linkage"},{"t":"term","c":"名词","q":"完全连锁的表现？","a":"无交换，自交仅两型 <b>3:1</b>","n":"完全连锁=不拆伙","deck":"genetics-flash","id":"genetics-flash_13","k":["linkage"],"h":"完全连锁=不交换（如果蝇雄），配子只有亲本型 1:1","hk":"linkage"},{"t":"term","c":"名词","q":"双交换指什么？","a":"两点间<b>同时发生两次交换</b>，多用于三点测交定序","n":"双交换=跳两下","deck":"genetics-flash","id":"genetics-flash_14","k":["linkage"]},{"t":"term","c":"名词","q":"符合系数(C)含义？","a":"实际双交换 / 期望双交换；<b>C=1无干扰，C=0完全干扰</b>","n":"C=1各干各的，C=0一颗不发","deck":"genetics-flash","id":"genetics-flash_15","k":["linkage"]},{"t":"term","c":"名词","q":"干扰系数(I)？","a":"<b>I = 1 − C</b>；I=0.3 即 30% 干扰","n":"I是C的补集","deck":"genetics-flash","id":"genetics-flash_16","k":["linkage"]},{"t":"term","c":"名词","q":"伴性遗传/性连锁？","a":"基因位于<b>性染色体</b>上，遗传与性别相关","n":"挂在性染色体上","deck":"genetics-flash","id":"genetics-flash_17","k":["sexlink"]},{"t":"term","c":"名词","q":"从性遗传 vs 限性遗传？","a":"从性：常染色体基因<b>显隐性随性别翻转</b>(秃顶)；限性：只在一性别表达","n":"从性翻显隐，限性只一边","deck":"genetics-flash","id":"genetics-flash_18","k":["sexlink","mendel"],"h":"限性看性别，从性看激素（早秃就是从性）","hk":"sexlink"},{"t":"term","c":"名词","q":"转化 / 接合 / 转导？","a":"转化=摄<b>游离DNA</b>(格里菲斯/艾弗里)；接合=菌毛转DNA(F/Hfr)；转导=噬菌体介导","n":"转自己/转邻居/转病毒带货","deck":"genetics-flash","id":"genetics-flash_19","k":["micro"],"h":"Griffith 发现转化现象，Avery 证明转化因子是 DNA","hk":"micro"},{"t":"term","c":"名词","q":"染色体缺失/重复/倒位/易位？","a":"缺失=丢段(缺失环)；重复=多段；倒位=颠倒(倒位环)；易位=非同源互换(十字形)","n":"缺环倒环保环，易位十字架","deck":"genetics-flash","id":"genetics-flash_20","k":["chromo"],"h":"缺失 = 把盖头掀了，隐性露脸，这叫假显性","hk":"chromo"},{"t":"term","c":"名词","q":"假显性 / 位置效应？","a":"假显性=缺失使<b>隐性暴露</b>；位置效应=易位改变表达","n":"假显性=隐的露脸了","deck":"genetics-flash","id":"genetics-flash_21","k":["chromo"],"h":"缺失 = 把盖头掀了，隐性露脸，这叫假显性","hk":"chromo"},{"t":"term","c":"名词","q":"单体/缺体/三体？","a":"单体 <b>2n−1</b>；缺体 2n−2；三体 2n+1","n":"单体少1条，三体多1条","deck":"genetics-flash","id":"genetics-flash_22","k":["num"],"h":"21 三体=唐氏；18 爱德华、13 帕陶——记住 21 最常见","hk":"num"},{"t":"term","c":"名词","q":"同源 vs 异源多倍体？","a":"同源=同物种加倍(AAaa)；异源=不同物种杂交加倍(小麦AABBDD)","n":"同源自己叠，异源混血叠","deck":"genetics-flash","id":"genetics-flash_23","k":["num"]},{"t":"term","c":"名词","q":"秋水仙素作用？","a":"抑制<b>纺锤体</b>形成 → 染色体加倍","n":"秋水拦纺锤","deck":"genetics-flash","id":"genetics-flash_24","k":["num"]},{"t":"term","c":"名词","q":"猫叫综合征 / 费城染色体？","a":"猫叫 = <b>5p−</b>；费城 = <b>9;22</b> 易位","n":"猫叫少5p，费城9换22","deck":"genetics-flash","id":"genetics-flash_25","k":["chromo"]},{"t":"term","c":"名词","q":"母性影响是什么？","a":"子代表型由<b>母本基因型</b>决定(椎实螺壳旋向)","n":"看娘的","deck":"genetics-flash","id":"genetics-flash_26","k":["cyto"],"h":"椎实螺看娘的基因型定壳旋，不是看自己","hk":"cyto"},{"t":"term","c":"名词","q":"莱昂化(剂量补偿)？","a":"雌性随机<b>失活一条X</b>(巴氏小体)，X−1原则","n":"女生闭一只X","deck":"genetics-flash","id":"genetics-flash_27","k":["sexlink"],"h":"莱昂假说：雌性随机灭一条 X，灭掉那条变巴氏小体","hk":"sexlink"},{"t":"term","c":"名词","q":"中心法则？","a":"<b>DNA → RNA → 蛋白</b>；无蛋白→核酸的反向","n":"遗传信息单向流","deck":"genetics-flash","id":"genetics-flash_28","k":["central"],"h":"中心法则的例外：逆转录（RNA→DNA）、RNA 复制","hk":"molecular"},{"t":"term","c":"比例","q":"互补作用比例","a":"<b>9:7</b>","n":"俩显性都要","deck":"genetics-flash","id":"genetics-flash_29","k":["interact"],"h":"9:7 = 两把钥匙开一把锁，缺一不可","hk":"interact"},{"t":"term","c":"比例","q":"积加作用比例","a":"<b>9:6:1</b>","n":"双显/单显/双隐","deck":"genetics-flash","id":"genetics-flash_30","k":["interact"],"h":"积加 9:6:1：两个显性各给一种表型，凑一起又是第三种","hk":"interact"},{"t":"term","c":"比例","q":"重叠作用比例","a":"<b>15:1</b>","n":"有一个就显","deck":"genetics-flash","id":"genetics-flash_31","k":["interact"],"h":"15:1：只要有一个显性就够，全隐才变","hk":"interact"},{"t":"term","c":"比例","q":"隐性上位比例","a":"<b>9:3:4</b>","n":"隐性压显性","deck":"genetics-flash","id":"genetics-flash_32","k":["interact"],"h":"9:3:4：bb 一票否决，把 B 的表现整个吞掉","hk":"interact"},{"t":"term","c":"比例","q":"显性上位比例","a":"<b>12:3:1</b>","n":"显性压一切","deck":"genetics-flash","id":"genetics-flash_33","k":["interact"],"h":"12:3:1：A 一在场，B 说什么都没用","hk":"interact"},{"t":"term","c":"比例","q":"抑制作用比例","a":"<b>13:3</b>","n":"抑制基因按住","deck":"genetics-flash","id":"genetics-flash_34","k":["interact"],"h":"抑制 13:3：I 在场就压住 C，只有 iiC_ 才显色","hk":"interact"},{"t":"term","c":"比例","q":"同源四倍体 AAaa 自交显:隐？","a":"<b>35:1</b>","n":"四倍体隐性超难出","deck":"genetics-flash","id":"genetics-flash_35","k":["interact","mendel"],"h":"AAa 分离：A : Aa : AA : a = 2 : 2 : 1 : 1","hk":"num"},{"t":"term","c":"比例","q":"AAaa 配子比例？","a":"<b>1AA : 4Aa : 1aa</b>","n":"中配最多","deck":"genetics-flash","id":"genetics-flash_36","k":["interact"],"h":"AAa 分离：A : Aa : AA : a = 2 : 2 : 1 : 1","hk":"num"},{"t":"term","c":"比例","q":"1 cM = ?","a":"<b>1% 重组率</b>","n":"图距单位","deck":"genetics-flash","id":"genetics-flash_37","k":["linkage","interact"],"h":"1 cM = 1% 重组率；距离远了要作图函数校正，不然低估","hk":"linkage"},{"t":"term","c":"比例","q":"完全连锁自交比例？","a":"仅两型 <b>3:1</b>","n":"不拆伙","deck":"genetics-flash","id":"genetics-flash_38","k":["linkage","interact"],"h":"完全连锁=不交换（如果蝇雄），配子只有亲本型 1:1","hk":"linkage"},{"t":"term","c":"比例","q":"谁在1909年提出'gene'(基因)？","a":"<b>约翰生</b>(非摩尔根)","n":"基因约翰生，连锁摩尔根","deck":"genetics-flash","id":"genetics-flash_39","k":["interact"]},{"t":"term","c":"踩坑","q":"符合系数 C=1 表示？","a":"实际双交换 = 期望 → <b>无干扰</b>","n":"C=1各干各的，别选'干扰'！","deck":"genetics-flash","id":"genetics-flash_40","k":["linkage"]},{"t":"term","c":"踩坑","q":"干扰系数 I=0.3 表示？","a":"<b>30% 干扰</b>；此时 C=0.7。负向干扰是 C>1(基本不考)","n":"I=0.3就是30%干扰，不是负向","deck":"genetics-flash","id":"genetics-flash_41","k":["linkage"]},{"t":"term","c":"踩坑","q":"三点测交怎么定中间基因？","a":"<b>最少见的双交换型</b>中，中间基因变位(两端不动)","n":"谁换位谁是中间","deck":"genetics-flash","id":"genetics-flash_42","k":["linkage"],"h":"三点测交：先挑最多的（亲本）和最少的（双交换），一比就知道谁在中间","hk":"linkage"},{"t":"term","c":"踩坑","q":"'F₁中红花植株随机交配'白花比例？","a":"先筛掉白花(红花里1/3CC,2/3Cc)→c频率1/3→白花=<b>1/9</b>","n":"先筛群体，再算配子频率，频率²","deck":"genetics-flash","id":"genetics-flash_43","k":["mendel"]},{"t":"term","c":"踩坑","q":"启动子P vs 操纵基因O 谁编码蛋白？","a":"都<b>不编码</b>：P是聚酶停车位，O是阻遏锁孔(负调控)","n":"P坐车，O是锁，都不造车","deck":"genetics-flash","id":"genetics-flash_44","k":["geneexp"],"h":"原核 -10 TATAAT、-35 TTGACA；真核是 TATA 盒","hk":"trans"},{"t":"term","c":"踩坑","q":"'一基因一酶'是谁提出的？","a":"<b>比德尔和塔特姆</b>(红面包霉)；摩尔根是果蝇连锁","n":"一酶比德尔，连锁摩尔根","deck":"genetics-flash","id":"genetics-flash_45","k":["linkage"]},{"t":"term","c":"踩坑","q":"人类秃顶属于哪种遗传？","a":"<b>从性遗传</b>：常染色体，Bb男秃女不秃(显隐性翻转)","n":"秃顶是常染上的性别翻转","deck":"genetics-flash","id":"genetics-flash_46","k":["sexlink","mendel"]},{"t":"term","c":"踩坑","q":"³²P 和 ³⁵S 分别标记什么？","a":"³²P 标 <b>DNA</b>(磷是核酸元素)；³⁵S 标 <b>蛋白质</b>","n":"P跟DNA走，S跟蛋白走","deck":"genetics-flash","id":"genetics-flash_47","k":["micro"]},{"t":"term","c":"踩坑","q":"费城染色体是哪两条易位？","a":"<b>9号与22号</b>相互易位(BCR-ABL融合，慢粒标志)","n":"9换22=费城","deck":"genetics-flash","id":"genetics-flash_48","k":["chromo"],"h":"相互易位配对成十字形；罗伯逊易位是两条近端着丝粒染色体融合","hk":"chromo"},{"t":"term","c":"填空","q":"连锁群数目 = ?","a":"= 单倍体染色体数 <b>n</b>","n":"数n就行","deck":"genetics-flash","id":"genetics-flash_49","k":["num","linkage"]},{"t":"term","c":"填空","q":"单体/缺体/三体 = ?","a":"<b>2n−1 / 2n−2 / 2n+1</b>","n":"少1/少2/多1","deck":"genetics-flash","id":"genetics-flash_50","k":["num"],"h":"21 三体=唐氏；18 爱德华、13 帕陶——记住 21 最常见","hk":"num"},{"t":"term","c":"填空","q":"人类三类畸变速记？","a":"猫叫=<b>5p−</b>；费城=<b>9;22</b>；唐氏=<b>21三体</b>","n":"5p猫叫，9-22费城，21唐氏","deck":"genetics-flash","id":"genetics-flash_51","k":["num"]},{"t":"term","c":"填空","q":"性别决定四型？","a":"XY(人/果蝇) / ZW(鸟/蝶) / XO(蝗虫) / 倍数型(蜜蜂孤雌产雄)","n":"XY人果蝇，ZW鸟蝶，蝗虫少X，蜜蜂看单双","deck":"genetics-flash","id":"genetics-flash_52","k":["sexlink"],"h":"决定在前（命运已定），分化在后（形态才变）","hk":"dev"},{"t":"term","c":"填空","q":"原核 mRNA 是否 5'戴帽、剪内含子？","a":"<b>不</b>戴帽、<b>不</b>剪内含子(真核才戴帽剪尾)","n":"原核简单粗暴","deck":"genetics-flash","id":"genetics-flash_53","k":["nucleic","trans"],"h":"剪接体由 snRNP 组成，剪掉内含子、拼起外显子","hk":"trans"},{"t":"term","c":"填空","q":"谁证明 DNA 是遗传物质(体外)？","a":"<b>艾弗里</b>(DNA酶处理失活)；体内转化是格里菲斯","n":"艾弗里定DNA，格里菲斯开头","deck":"genetics-flash","id":"genetics-flash_54","k":["nucleic","micro","central"]}]